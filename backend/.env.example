# Copy to backend/.env and fill in. Never commit real values.
# Full descriptions: backend/README.md and docs/environment.md.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173

# Supabase (backend-only secrets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Document analysis
GEMINI_API_KEY=
# GEMINI_MODEL=

# Invitation email: "brevo" for real delivery, or "console" for offline development and tests.
TRANSACTIONAL_EMAIL_PROVIDER=brevo
# Required when the provider is brevo. The sender must be verified in Brevo.
BREVO_API_KEY=
INVITATION_EMAIL_FROM=
# Optional display name (default: Supervisor AI)
# INVITATION_EMAIL_FROM_NAME=Supervisor AI

# Optional
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_MAX_KEYS=50000
# Auth rate limits (see backend/README.md "Authentication rate limits"). On Render set TRUST_PROXY_HOPS=1.
# TRUST_PROXY_HOPS=0
# AUTH_RL_LOGIN_WINDOW_MS=900000
# AUTH_RL_LOGIN_IP_MAX=30
# AUTH_RL_LOGIN_EMAIL_MAX=20
# AUTH_RL_LOGIN_PAIR_WINDOW_MS=600000
# AUTH_RL_LOGIN_PAIR_MAX=5
# AUTH_RL_REGISTER_WINDOW_MS=3600000
# AUTH_RL_REGISTER_IP_MAX=5
# AUTH_RL_REGISTER_EMAIL_MAX=3
# AUTH_RL_RESET_IP_WINDOW_MS=900000
# AUTH_RL_RESET_IP_MAX=5
# AUTH_RL_RESET_EMAIL_WINDOW_MS=3600000
# AUTH_RL_RESET_EMAIL_MAX=3
# AUTH_RL_RESET_EMAIL_DAILY_MAX=5
# AUTH_RL_RESET_DAILY_TOTAL_MAX=100
# AUTH_RL_RESET_CONFIRM_IP_MAX=10
# AUTH_RL_INVITATION_WINDOW_MS=900000
# AUTH_RL_INVITATION_INSPECT_IP_MAX=30
# AUTH_RL_INVITATION_REGISTER_IP_MAX=10
# AUTH_RL_INVITATION_ACCEPT_IP_MAX=20
# AUTH_RL_ADMIN_CREATE_USER_WINDOW_MS=3600000
# AUTH_RL_ADMIN_CREATE_USER_MAX=20
# AUTH_RL_UPSTREAM_RETRY_AFTER_SECONDS=60
# APP_VERSION=
# JSON_BODY_LIMIT=
# AUTH_LEGACY_EMPLOYEE_SIGNUP_ENABLED=false
# INVITATION_DEBUG_RETURN_URL=false

# One-time platform admin bootstrap (npm run bootstrap:first-platform-admin)
# PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
# PLATFORM_ADMIN_BOOTSTRAP_CONFIRM=

# Development database reset only
# APP_ENV=development
# ALLOW_DATABASE_RESET=false
